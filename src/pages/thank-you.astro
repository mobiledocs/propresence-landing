---
const INTAKE_URL = "/intake";

const WHATSAPP_URL =
  "https://wa.me/REPLACE_NUMBER?text=Hi%20ProPresence%2C%20I%20just%20completed%20my%20purchase%20and%20I%27d%20like%20to%20send%20my%20professional%20information.";

const MESSENGER_URL =
  "https://m.me/REPLACE_PAGE_USERNAME";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta name="robots" content="noindex, nofollow" />

    <title>Thank You — ProPresence</title>

    <meta
      name="description"
      content="Thank you for purchasing your ProPresence professional profile."
    />

    <style>
      :root {
        --bg: #02090b;
        --card: #09171b;
        --card-soft: #0c1e22;
        --text: #f5fbfc;
        --muted: #9db2b7;
        --cyan: #23e8ef;
        --cyan-soft: rgba(35, 232, 239, 0.14);
        --green: #25d366;
        --line: rgba(255, 255, 255, 0.1);
        --max: 900px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;

        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;

        color: var(--text);

        background:
          radial-gradient(
            circle at 50% 5%,
            rgba(35, 232, 239, 0.13),
            transparent 35%
          ),
          var(--bg);

        line-height: 1.6;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .container {
        width: min(calc(100% - 32px), var(--max));
        margin-inline: auto;
      }

      /* HEADER */

      header {
        border-bottom: 1px solid var(--line);

        background: rgba(2, 9, 11, 0.88);
        backdrop-filter: blur(18px);
      }

      .nav {
        min-height: 74px;

        display: flex;
        align-items: center;
        justify-content: center;
      }

      .brand {
        font-size: 1.55rem;
        font-weight: 900;
        letter-spacing: -0.04em;
      }

      .brand span {
        color: var(--cyan);
      }

      /* MAIN */

      main {
        padding: 72px 0 90px;
      }

      .success {
        text-align: center;

        max-width: 720px;
        margin: 0 auto 50px;
      }

      .check {
        width: 72px;
        height: 72px;

        margin: 0 auto 24px;

        display: grid;
        place-items: center;

        border-radius: 50%;

        background: rgba(37, 211, 102, 0.14);
        border: 1px solid rgba(37, 211, 102, 0.38);

        color: var(--green);

        font-size: 2rem;
        font-weight: 900;
      }

      .eyebrow {
        color: var(--cyan);

        font-size: 0.78rem;
        font-weight: 900;

        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      h1 {
        margin: 10px 0 17px;

        font-size: clamp(2.7rem, 7vw, 4.7rem);
        line-height: 1;

        letter-spacing: -0.055em;
      }

      .success p {
        margin: 0 auto;

        max-width: 650px;

        color: var(--muted);

        font-size: 1.08rem;
      }

      .highlight {
        color: white;
        font-weight: 700;
      }

      /* NEXT STEP */

      .next-card {
        padding: 36px;

        border: 1px solid rgba(35, 232, 239, 0.25);
        border-radius: 26px;

        background:
          radial-gradient(
            circle at top right,
            rgba(35, 232, 239, 0.09),
            transparent 35%
          ),
          var(--card);

        box-shadow: 0 30px 90px rgba(0, 0, 0, 0.4);
      }

      .next-card h2 {
        margin: 0 0 10px;

        font-size: clamp(1.9rem, 5vw, 2.7rem);
        letter-spacing: -0.04em;
      }

      .next-card > p {
        margin: 0 0 28px;

        color: var(--muted);
      }

      /* SOURCES */

      .sources {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;

        margin-bottom: 28px;
      }

      .source {
        padding: 9px 13px;

        border: 1px solid var(--line);
        border-radius: 999px;

        background: rgba(255, 255, 255, 0.025);

        color: #dbe7e9;

        font-size: 0.88rem;
      }

      .note {
        padding: 16px 18px;
        margin-bottom: 30px;

        border-left: 3px solid var(--cyan);
        border-radius: 8px;

        background: var(--cyan-soft);

        color: #d8e6e8;

        font-size: 0.93rem;
      }

      /* ACTIONS */

      .actions {
        display: grid;
        gap: 13px;
      }

      .button {
        min-height: 58px;

        padding: 0 22px;

        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;

        border-radius: 14px;

        font-weight: 800;

        transition:
          transform 0.18s ease,
          border-color 0.18s ease;
      }

      .button:hover {
        transform: translateY(-2px);
      }

      .button strong {
        display: block;
        font-size: 1rem;
      }

      .button small {
        display: block;

        margin-top: 1px;

        color: var(--muted);

        font-weight: 500;
      }

      .button-arrow {
        font-size: 1.35rem;
      }

      .primary {
        background: var(--green);
        color: white;
      }

      .primary small {
        color: rgba(255, 255, 255, 0.8);
      }

      .secondary {
        border: 1px solid var(--line);

        background: var(--card-soft);
      }

      .secondary:hover {
        border-color: rgba(35, 232, 239, 0.35);
      }

      /* PROCESS */

      .process {
        margin-top: 52px;
      }

      .process-title {
        margin-bottom: 22px;

        text-align: center;
      }

      .process-title h2 {
        margin: 0 0 7px;

        font-size: 1.7rem;
      }

      .process-title p {
        margin: 0;

        color: var(--muted);
      }

      .steps {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
      }

      .step {
        padding: 23px;

        text-align: center;

        border: 1px solid var(--line);
        border-radius: 17px;

        background: var(--card);
      }

      .number {
        width: 36px;
        height: 36px;

        margin: 0 auto 12px;

        display: grid;
        place-items: center;

        border-radius: 50%;

        background: var(--cyan-soft);
        color: var(--cyan);

        font-weight: 900;
      }

      .step h3 {
        margin: 0 0 5px;

        font-size: 1rem;
      }

      .step p {
        margin: 0;

        color: var(--muted);

        font-size: 0.87rem;
      }

      /* FOOTER */

      footer {
        padding: 30px 0;

        border-top: 1px solid var(--line);

        text-align: center;

        color: #6f858a;

        font-size: 0.84rem;
      }

      @media (max-width: 650px) {
        main {
          padding: 48px 0 68px;
        }

        .next-card {
          padding: 27px 20px;
        }

        .steps {
          grid-template-columns: 1fr;
        }

        .button {
          min-height: 66px;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <div class="container nav">
        <a class="brand" href="/">
          Pro<span>Presence</span>
        </a>
      </div>
    </header>

    <main>
      <div class="container">
        <!-- SUCCESS -->

        <section class="success">
          <div class="check">✓</div>

          <div class="eyebrow">
            Payment completed
          </div>

          <h1>
            Welcome to ProPresence.
          </h1>

          <p>
            Your order is confirmed. Now we just need your
            professional information so we can start building 
            <span class="highlight"> your personal professional presence.</span>
          </p>
        </section>

        <!-- NEXT STEP -->

        <section class="next-card">
          <div class="eyebrow">
            Next step
          </div>

          <h2>
            Send us your information your way.
          </h2>

          <p>
            You do not need to prepare anything special.
            Send whatever professional information you already have,
            using the method that is easiest for you.
          </p>

          <div class="sources">
            <div class="source">LinkedIn</div>
            <div class="source">Website</div>
            <div class="source">Professional Bio</div>
            <div class="source">CV</div>
            <div class="source">Social Profiles</div>
            <div class="source">Documents</div>
            <div class="source">Short Form</div>
          </div>

          <div class="note">
            You don't need to send everything. One or more sources
            are enough to get started. If anything important is
            missing, we'll contact you.
          </div>

          <div class="actions">
            <a
              class="button primary"
              href={INTAKE_URL}
            >
              <div>
                <strong>Complete the Short Form</strong>
                <small>
                  Send your information in a few simple steps
                </small>
              </div>

              <span class="button-arrow">→</span>
            </a>

            <a
              class="button secondary"
              href={WHATSAPP_URL}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div>
                <strong>Send via WhatsApp</strong>
                <small>
                  Send links, information or documents directly
                </small>
              </div>

              <span class="button-arrow">→</span>
            </a>

            <a
              class="button secondary"
              href={MESSENGER_URL}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div>
                <strong>Continue on Messenger</strong>
                <small>
                  Send your information through Facebook Messenger
                </small>
              </div>

              <span class="button-arrow">→</span>
            </a>
          </div>
        </section>

        <!-- WHAT HAPPENS NEXT -->

        <section class="process">
          <div class="process-title">
            <h2>What happens next?</h2>

            <p>
              We'll take it from here.
            </p>
          </div>

          <div class="steps">
            <article class="step">
              <div class="number">1</div>

              <h3>We review your information</h3>

              <p>
                We organize the information you send and identify
                the strongest parts of your professional profile.
              </p>
            </article>

            <article class="step">
              <div class="number">2</div>

              <h3>We build your ProPresence</h3>

              <p>
                Your experience, expertise, achievements and
                contact options are presented professionally.
              </p>
            </article>

            <article class="step">
              <div class="number">3</div>

              <h3>You review & approve</h3>

              <p>
                You review the result before your professional
                page is published and ready to share.
              </p>
            </article>
          </div>
        </section>
      </div>
    </main>

    <footer>
      <div class="container">
        © 2026 ProPresence · Professional presence. One link.
      </div>
    </footer>
  </body>
</html>