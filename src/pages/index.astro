---
const CHECKOUT_URL = "https://buy.stripe.com/REPLACE_ME";
const WHATSAPP_URL = "https://wa.me/REPLACE_NUMBER";
const MESSENGER_URL = "https://m.me/REPLACE_PAGE_USERNAME";

const benefits = [
  {
    title: "One Professional Presence",
    text: "Bring your experience, expertise, achievements, professional links and contact details together in one polished page."
  },
  {
    title: "Easy to Share",
    text: "Share one personal link instead of sending people across multiple profiles, documents and platforms."
  },
  {
    title: "Direct Contact",
    text: "Let people reach you directly through WhatsApp, phone, email and your professional links."
  },
  {
    title: "Works Everywhere",
    text: "Your profile is designed to look great on mobile, tablet and desktop."
  },
  {
    title: "Your CV or Profile",
    text: "Add your CV when relevant, make it downloadable, or use your page as a professional profile without one."
  },
  {
    title: "Always Online",
    text: "Hosting is included for one full year, with one content update included every month."
  }
];

const audiences = [
  "Business Owners",
  "Consultants",
  "Executives",
  "Doctors",
  "Dentists",
  "Lawyers",
  "Sales Professionals",
  "Marketing Professionals",
  "Freelancers",
  "Coaches & Trainers"
];

const images = [
  "/images/01-profile.png",
  "/images/02-profile.png",
  "/images/03-profile.png",
  "/images/04-profile.png",
  "/images/05-profile.png"
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>ProPresence — Your Professional Presence in One Link</title>

    <meta
      name="description"
      content="Turn your experience, expertise and professional identity into one polished personal profile. One link. Easy sharing. Direct contact. Hosting included."
    />

    <style>
      :root {
        --bg: #02090b;
        --bg-soft: #061216;
        --card: #09171b;
        --card-2: #0b1d21;
        --text: #f5fbfc;
        --muted: #9db2b7;
        --cyan: #23e8ef;
        --cyan-soft: rgba(35, 232, 239, 0.16);
        --green: #25d366;
        --line: rgba(255, 255, 255, 0.1);
        --max: 1180px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;

        color: var(--text);

        background:
          radial-gradient(
            circle at 75% 10%,
            rgba(21, 220, 226, 0.14),
            transparent 30%
          ),
          radial-gradient(
            circle at 10% 40%,
            rgba(21, 220, 226, 0.07),
            transparent 25%
          ),
          var(--bg);

        line-height: 1.6;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img {
        display: block;
        width: 100%;
        height: auto;
      }

      .container {
        width: min(calc(100% - 36px), var(--max));
        margin-inline: auto;
      }

      /* HEADER */

      header {
        position: sticky;
        top: 0;
        z-index: 100;

        background: rgba(2, 9, 11, 0.88);
        backdrop-filter: blur(18px);

        border-bottom: 1px solid var(--line);
      }

      .nav {
        min-height: 76px;

        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .brand {
        font-size: 1.55rem;
        font-weight: 900;
        letter-spacing: -0.04em;
      }

      .brand span {
        color: var(--cyan);
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 28px;

        color: var(--muted);
        font-size: 0.95rem;
      }

      .nav-cta {
        padding: 11px 20px;

        border-radius: 999px;

        background: var(--green);
        color: white;

        font-weight: 800;
      }

      /* HERO */

      .hero {
        padding: 78px 0 72px;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 0.92fr 1.08fr;
        gap: 64px;
        align-items: center;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 9px;

        padding: 8px 13px;
        margin-bottom: 22px;

        border: 1px solid rgba(35, 232, 239, 0.35);
        border-radius: 999px;

        background: var(--cyan-soft);

        color: var(--cyan);

        font-weight: 800;
        font-size: 0.78rem;

        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0 0 22px;

        max-width: 720px;

        font-size: clamp(3rem, 6vw, 5.6rem);
        line-height: 0.98;
        letter-spacing: -0.065em;
      }

      h1 span {
        color: var(--cyan);
      }

      .hero-copy {
        max-width: 650px;

        margin: 0 0 30px;

        color: #c0d0d4;

        font-size: clamp(1.05rem, 2vw, 1.24rem);
      }

      .hero-copy strong {
        color: white;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;

        margin-bottom: 24px;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;

        min-height: 54px;
        padding: 0 24px;

        border-radius: 13px;

        font-weight: 850;

        transition:
          transform 0.18s ease,
          opacity 0.18s ease;
      }

      .button:hover {
        transform: translateY(-2px);
      }

      .button-primary {
        background: var(--green);
        color: white;

        box-shadow: 0 15px 45px rgba(37, 211, 102, 0.2);
      }

      .button-secondary {
        border: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.04);
      }

      .hero-note {
        color: #879da2;
        font-size: 0.9rem;
      }

      .hero-note strong {
        color: #d9e7e9;
      }

      .image-frame {
        overflow: hidden;

        aspect-ratio: 1 / 1;

        border: 1px solid rgba(35, 232, 239, 0.22);
        border-radius: 28px;

        background: #041013;

        box-shadow:
          0 32px 100px rgba(0, 0, 0, 0.55),
          0 0 65px rgba(35, 232, 239, 0.08);
      }

      .image-frame img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      /* TRUST STRIP */

      .trust-strip {
        padding: 22px 0;

        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);

        background: rgba(255, 255, 255, 0.018);
      }

      .trust-items {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
      }

      .trust-item {
        text-align: center;
      }

      .trust-item strong {
        display: block;
        color: white;
        font-size: 1rem;
      }

      .trust-item span {
        color: var(--muted);
        font-size: 0.84rem;
      }

      /* SHARED SECTIONS */

      section {
        padding: 64px 0;
      }

      .section-heading {
  max-width: 790px;
  margin: 0 auto 34px;
  text-align: center;
}

      .section-heading .label {
        color: var(--cyan);

        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;

        font-size: 0.76rem;
      }

      h2 {
        margin: 10px 0 14px;

        font-size: clamp(2.2rem, 4.8vw, 4rem);
        line-height: 1.03;
        letter-spacing: -0.05em;
      }

      .section-heading p {
        color: var(--muted);

        margin: 0 auto;

        max-width: 680px;

        font-size: 1.05rem;
      }

      /* AUDIENCE */

      .audience-tags {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
      }

      .audience-section {
  padding-bottom: 48px;
}

#benefits {
  padding-top: 48px;
}

#benefits,
#examples,
#how,
#pricing {
  scroll-margin-top: 130px;
}

      .audience-tag {
        padding: 12px 17px;

        border: 1px solid var(--line);
        border-radius: 999px;

        color: #d8e4e6;

        background: rgba(255, 255, 255, 0.025);
      }

      /* BENEFITS */

      .benefits {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
      }

      .benefit {
        padding: 28px;

        border: 1px solid var(--line);
        border-radius: 20px;

        background:
          linear-gradient(
            160deg,
            rgba(35, 232, 239, 0.045),
            transparent 45%
          ),
          var(--card);
      }

      .benefit-icon {
        width: 42px;
        height: 42px;

        display: grid;
        place-items: center;

        margin-bottom: 19px;

        border-radius: 11px;

        background: var(--cyan-soft);
        color: var(--cyan);

        font-size: 1.2rem;
      }

      .benefit h3 {
        margin: 0 0 8px;

        font-size: 1.15rem;
      }

      .benefit p {
        margin: 0;

        color: var(--muted);

        font-size: 0.94rem;
      }

      /* GALLERY */

      .gallery {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 22px;
      }

      .gallery-card {
        overflow: hidden;

        aspect-ratio: 1 / 1;

        border: 1px solid var(--line);
        border-radius: 24px;

        background: var(--card);

        box-shadow: 0 20px 55px rgba(0, 0, 0, 0.28);
      }

      .gallery-card img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }


      /* HOW IT WORKS */

      .steps {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
      }

      .step {
        padding: 27px;

        border-top: 2px solid var(--cyan);
        border-radius: 16px;

        background: var(--card);
      }

      .step-number {
        color: var(--cyan);

        font-size: 0.8rem;
        font-weight: 900;

        letter-spacing: 0.12em;
      }

      .step h3 {
        margin: 10px 0 8px;

        font-size: 1.12rem;
      }

      .step p {
        margin: 0;

        color: var(--muted);

        font-size: 0.92rem;
      }

      /* PRICING */

      .pricing-wrap {
        max-width: 720px;
        margin: 0 auto;
      }

      .pricing-card {
        position: relative;
        overflow: hidden;

        padding: 42px;

        border: 1px solid rgba(35, 232, 239, 0.35);
        border-radius: 28px;

        background:
          radial-gradient(
            circle at top right,
            rgba(35, 232, 239, 0.12),
            transparent 35%
          ),
          var(--card);

        box-shadow:
          0 35px 110px rgba(0, 0, 0, 0.45),
          0 0 60px rgba(35, 232, 239, 0.07);
      }

      .pricing-badge {
        display: inline-block;

        margin-bottom: 18px;
        padding: 7px 11px;

        border-radius: 999px;

        background: var(--cyan-soft);
        color: var(--cyan);

        font-size: 0.75rem;
        font-weight: 900;

        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .price {
        margin: 0;

        font-size: clamp(4rem, 9vw, 6.6rem);
        line-height: 0.9;

        font-weight: 900;
        letter-spacing: -0.07em;
      }

      .price span {
        color: var(--muted);

        font-size: 1rem;
        font-weight: 500;

        letter-spacing: 0;
      }

      .price-description {
        margin: 18px 0 28px;

        color: var(--muted);
      }

      .includes {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 11px 24px;

        margin: 0 0 32px;
        padding: 0;

        list-style: none;
      }

      .includes li {
        position: relative;

        padding-left: 25px;

        color: #d8e5e7;

        font-size: 0.94rem;
      }

      .includes li::before {
        content: "✓";

        position: absolute;
        left: 0;

        color: var(--green);

        font-weight: 900;
      }

      .checkout-button {
        width: 100%;

        min-height: 60px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 14px;

        background: var(--green);

        color: white;

        font-size: 1.05rem;
        font-weight: 900;

        box-shadow: 0 18px 50px rgba(37, 211, 102, 0.2);
      }

      .payment-note {
        margin-top: 13px;

        text-align: center;

        color: #81979c;

        font-size: 0.82rem;
      }

      /* AFTER PAYMENT */

      .after-payment {
        max-width: 850px;
        margin: 0 auto;

        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
      }

      .after-card {
        padding: 25px;

        text-align: center;

        border: 1px solid var(--line);
        border-radius: 18px;

        background: var(--card);
      }

      .after-number {
        width: 38px;
        height: 38px;

        display: grid;
        place-items: center;

        margin: 0 auto 14px;

        border-radius: 50%;

        background: var(--cyan-soft);
        color: var(--cyan);

        font-weight: 900;
      }

      .after-card h3 {
        margin: 0 0 7px;
      }

      .after-card p {
        margin: 0;

        color: var(--muted);

        font-size: 0.9rem;
      }

      /* FAQ */

      .faq {
        max-width: 820px;
        margin: 0 auto;
      }

      details {
        padding: 21px 0;

        border-bottom: 1px solid var(--line);
      }

      summary {
        cursor: pointer;

        font-size: 1.03rem;
        font-weight: 750;
      }

      details p {
        margin: 12px 0 0;

        color: var(--muted);
      }

      /* SUPPORT */

      .support-box {
        max-width: 880px;
        margin: 0 auto;

        padding: 40px;

        text-align: center;

        border: 1px solid var(--line);
        border-radius: 24px;

        background: var(--card);
      }

      .support-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;

        margin-top: 22px;
      }

      /* FOOTER */

      footer {
        padding: 38px 0;

        border-top: 1px solid var(--line);

        color: #73898e;

        font-size: 0.86rem;
      }

      .footer-grid {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
      }

      /* TABLET + MOBILE */

@media (max-width: 900px) {
  .nav {
    min-height: auto;
    padding: 10px 0 9px;

    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto auto;
    gap: 8px 12px;
  }

  .brand {
    grid-column: 1;
    grid-row: 1;

    align-self: center;

    min-width: 0;
  }

  .nav-cta {
    grid-column: 2;
    grid-row: 1;

    align-self: center;

    white-space: nowrap;
  }

  .nav-links {
    grid-column: 1 / -1;
    grid-row: 2;

    display: flex;
    align-items: center;

    min-width: 0;
    width: 100%;

    gap: 8px;

    overflow-x: auto;
    overscroll-behavior-inline: contain;

    padding: 2px 0 0;

    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .nav-links::-webkit-scrollbar {
    display: none;
  }

  .nav-links a {
    flex: 0 0 auto;

    padding: 7px 12px;

    border: 1px solid var(--line);
    border-radius: 999px;

    background: rgba(255, 255, 255, 0.035);

    color: #c8d7da;

    font-size: 0.82rem;
    font-weight: 650;

    white-space: nowrap;
  }

  .hero {
    padding: 50px 0 48px;
  }

  .hero-grid {
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .hero-content {
    text-align: center;
  }

  .hero-copy {
    margin-left: auto;
    margin-right: auto;
  }

  .hero-actions {
    justify-content: center;
  }

  .trust-items {
    grid-template-columns: repeat(2, 1fr);
  }

  .benefits {
    grid-template-columns: repeat(2, 1fr);
  }

  .steps {
    grid-template-columns: repeat(2, 1fr);
  }
}


/* PHONE */

@media (max-width: 620px) {
